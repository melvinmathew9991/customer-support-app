# Copy this file to .env and adjust as needed.
# Default provider is local Ollama - no API key required.

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Embeddings used for the RAG help-center indexes.
# "ollama" uses a local Ollama embedding model (e.g. nomic-embed-text) - no
# extra heavy deps (torch) required, and avoids Windows MAX_PATH issues with
# torch's own install when the repo lives deep in OneDrive/etc.
# "sentence-transformers" runs locally via HuggingFace but pulls in torch.
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# LangChain AgentExecutor step-by-step tool-call tracing. Off by default for
# a clean console; set true to debug agent/tool-calling behavior.
AGENT_VERBOSE=false
LOG_LEVEL=INFO

# Upper bounds on one LLM call. A small local model can fail to stop generating and
# run to its context limit; these turn that hang into a short reply (#30).
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# Override if you want the knowledge base / vector store somewhere else.
# Default: <project root>/assets and <project root>/chroma_db
# ASSETS_DIR=
# CHROMA_DIR=

# Structured per-turn JSON-line log (node, retrieval, tool calls, latency) -
# see docs/eval/Metrics.md. Default: <project root>/logs/turns.jsonl
# TURN_LOG_PATH=

# Where saved conversations live so they survive a restart (see docs/Persistence-Design.md).
# A session holds the user's name, email and phone number in the clear - keep this file out
# of git and treat it as personal data. Default: <project root>/data/sessions.sqlite
# SESSION_DB_PATH=

# Backend for the user-identification lookup (see docs/User-Store-Design.md).
# "sqlite" (default) is a real, persistent store, auto-seeded with the same sample users
# "mock" holds in memory. "mock" skips file I/O - handy for quick local runs.
USER_STORE_PROVIDER=sqlite
# Default: <project root>/data/users.sqlite
# USER_STORE_DB_PATH=
